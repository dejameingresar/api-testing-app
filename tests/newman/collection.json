{
  "info": {
    "name": "api-testing-app",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('body ok', () => { const j = pm.response.json(); pm.expect(j.status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "list items",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/items" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "create item",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"name\": \"newman-item\"}" },
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"]
          }
        }
      ]
    },
    {
      "name": "get missing item",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/items/999999" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));"]
          }
        }
      ]
    }
  ]
}
